{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Moneyball: Debug Streamlit",
            "type": "debugpy",
            "request": "launch",
            "module": "streamlit",
            "args": [
                "run",
                "${workspaceFolder}/app.py",
                "--server.headless",
                "true"
            ],
            "justMyCode": false,
            "console": "integratedTerminal"
        }
    ]
}